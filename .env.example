# 复制为 .env 后填写本机私有配置。
# .env 已被 .gitignore 忽略，不会进入仓库。
# 也可以直接设置同名环境变量（环境变量优先）。

# 微信账号 wxid（stories-in-wx 里的账号）
SIWX_ACCOUNT=wxid_xxxxxxxxxxxx

# 默认群 username 与群名
SIWX_CHAT=12345678901@chatroom
SIWX_CHAT_NAME=示例群

# 可选：SIWX 未返回解密输出目录时的兜底路径
SIWX_OUTPUT_ROOT=

# 内置总结引擎：OpenAI 兼容接口
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 定时与报告时区（可选；不填或读取失败时使用 UTC+8）
WXREPORT_TIMEZONE=Asia/Shanghai
WXREPORT_CRON=0 0 0,4,8,12,16,20 * * *

# 是否上传 OSS（默认 false；设为 true 且配置 OSS 后才上传）
WXREPORT_UPLOAD=false
# 是否输出每话题的参与者名单（默认 true）
WXREPORT_PARTICIPANTS=true
# 是否压缩长图（本地 256 色量化，失败或压不小就保留原图；默认 true）
WXREPORT_COMPRESS=true
# 长图顶部标题（可选；默认使用报告标题，即「群名」24 小时话题 TOP10）
WXREPORT_TITLE=
# 报告主题（默认 moments；可选 moments / minimal）
WXREPORT_THEME=moments

# OSS 上传（可选；不配置则只生成本地长图）
# Bucket 需为「公共读」，否则图片地址无法匿名访问。
OSS_BUCKET=
OSS_REGION=oss-cn-shanghai
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 上传路径，默认 latest-report.png（Bucket 根目录）
OSS_PATH=latest-report.png
# 可选：自定义域名/CDN。不填则使用 https://<bucket>.<endpoint>/<key>
OSS_DOMAIN=
