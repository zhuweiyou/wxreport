# 可选：复制为 config/oss.env 后填写；该文件已被 .gitignore 忽略。
# 不配置时 wxreport shot 只生成本地 runs/latest.png，跳过上传。
# Bucket 需为「公共读」，否则图片地址无法匿名访问。
OSS_BUCKET=
OSS_REGION=oss-cn-shanghai
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：自定义域名/CDN。不填则使用 https://<bucket>.<endpoint>/<key>
OSS_DOMAIN=
